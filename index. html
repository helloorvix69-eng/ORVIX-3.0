<script>
const EMAIL = "hello@orvix.com";
const WORKER_URL = "https://orvix-ai.hello-orvix-69.workers.dev";
const $ = s => document.querySelector(s);
const $$ = s => [...document.querySelectorAll(s)];

const root = document.documentElement;
function setTheme(t){
  root.dataset.theme = t;
  $("#themeBtn").textContent = t === "dark" ? "☀️" : "🌙";
  try{ localStorage.setItem("orvix-theme2", t); }catch(e){}
}
let saved = null;
try{ saved = localStorage.getItem("orvix-theme2"); }catch(e){}
setTheme(saved || "light");
$("#themeBtn").onclick = () => setTheme(root.dataset.theme === "dark" ? "light" : "dark");

$("#menuBtn").onclick = () => {
  const open = $("#nav").classList.toggle("open");
  $("#menuBtn").setAttribute("aria-expanded", open);
};
$$("#nav a").forEach(a => a.onclick = () => $("#nav").classList.remove("open"));

const words = ["automates your work.", "answers your customers.", "reads your data.", "grows your business."];
let wi = 0, ci = 0, del = false;
const typed = $("#typed");
const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
function tick(){
  const w = words[wi];
  if(still){ typed.textContent = w; return; }
  typed.textContent = w.slice(0, ci);
  if(!del && ci === w.length){ del = true; return setTimeout(tick, 1600); }
  if(del && ci === 0){ del = false; wi = (wi + 1) % words.length; }
  ci += del ? -1 : 1;
  setTimeout(tick, del ? 30 : 65);
}
tick();

if("IntersectionObserver" in window && !still){
  const io = new IntersectionObserver(es => es.forEach(e => {
    if(!e.isIntersecting) return;
    const el = e.target, end = +el.dataset.count, suf = el.dataset.suffix || "";
    let n = 0;
    const step = Math.max(1, Math.ceil(end / 40));
    const t = setInterval(() => {
      n = Math.min(end, n + step);
      el.textContent = n + suf;
      if(n === end) clearInterval(t);
    }, 35);
    io.unobserve(el);
  }), {threshold:.6});
  $$("[data-count]").forEach(el => io.observe(el));
}

$$(".chip").forEach(c => c.onclick = () => {
  $$(".chip").forEach(x => x.setAttribute("aria-pressed", x === c));
  $$(".proj").forEach(p => p.hidden = !(c.dataset.f === "all" || p.dataset.cat === c.dataset.f));
});

const log = $("#log");
const history = [];
let busy = false;

function add(text, who){
  const d = document.createElement("div");
  d.className = "msg " + who; d.textContent = text;
  log.appendChild(d); log.scrollTop = log.scrollHeight;
  return d;
}
function fallback(q){
  q = q.toLowerCase();
  if(/founder|ceo|ayush|owner/.test(q)) return "ORVIX was founded by Ayush Kumar, who is also the CEO.";
  if(/contact|email|mail|reach|call/.test(q)) return "Write to " + EMAIL + " or use the contact form below.";
  return "Sorry, the AI is busy right now. Please try again in a moment or email " + EMAIL + ".";
}
add("Hi, I’m the ORVIX assistant. Ask me anything!", "bot");

async function ask(q){
  q = q.trim();
  if(!q || busy) return;
  busy = true;
  $("#sendBtn").disabled = true;
  add(q, "me");
  history.push({role:"user", text:q});
  const wait = add("Thinking...", "bot");
  wait.classList.add("wait");
  let answer;
  try{
    const r = await fetch(WORKER_URL, {
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({messages:history})
    });
    const d = await r.json();
    answer = d.reply || fallback(q);
  }catch(e){
    answer = fallback(q);
  }
  wait.classList.remove("wait");
  wait.textContent = answer;
  history.push({role:"bot", text:answer});
  log.scrollTop = log.scrollHeight;
  busy = false;
  $("#sendBtn").disabled = false;
}
$("#chatForm").onsubmit = e => { e.preventDefault(); const v = $("#chatIn").value; $("#chatIn").value = ""; ask(v); };
$$("#quick button").forEach(b => b.onclick = () => ask(b.textContent));

$("#cform").onsubmit = e => {
  e.preventDefault();
  const n = $("#cn").value.trim(), m = $("#ce").value.trim(), t = $("#cm").value.trim();
  const okM = /^\S+@\S+\.\S+$/.test(m);
  $("#en").textContent = n ? "" : "Please enter your name.";
  $("#ee").textContent = okM ? "" : "Please enter a valid email.";
  $("#em").textContent = t.length >= 10 ? "" : "Please write at least 10 characters.";
  if(!n || !okM || t.length < 10) return;
  const body = encodeURIComponent(t + "\n\nFrom: " + n + " (" + m + ")");
  location.href = "mailto:" + EMAIL + "?subject=" + encodeURIComponent("Project enquiry from " + n) + "&body=" + body;
  $("#thanks").textContent = "Thanks! Your email app should open now.";
};

addEventListener("scroll", () => {
  const h = document.documentElement;
  $("#progress").style.width = (h.scrollTop / (h.scrollHeight - h.clientHeight) * 100) + "%";
  $("#toTop").classList.toggle("show", h.scrollTop > 600);
}, {passive:true});
$("#toTop").onclick = () => scrollTo({top:0, behavior:"smooth"});
</script>
